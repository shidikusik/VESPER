config_version=5

[application]
config/name="VESPER — Песнь глубин"
config/version="1.0.1"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.016, 0.027, 0.055, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[rendering]
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=4
limits/global_shader_variables/buffer_size=64
gl_compatibility/item_buffer_size=64
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.016, 0.027, 0.055, 1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
